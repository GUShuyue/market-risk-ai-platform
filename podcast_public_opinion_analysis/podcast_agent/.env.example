# ============================================================
# Podcast Agent 环境变量配置
# 复制此文件为 .env 并填入你的API密钥
# ============================================================

# Listen Notes API (播客搜索)
# 注册地址: https://www.listennotes.com/api/
LISTENNOTES_API_KEY=

# === 播客采集配置 ===
# 指定采集的播客名称（英文逗号分隔），Collector 会抓取这些播客的最新节目
# 不配置则使用 config.py 里的 DEFAULT_TARGET_PODCASTS 默认列表
# 示例: TARGET_PODCASTS=Bloomberg Surveillance,Odd Lots,MacroVoices
#TARGET_PODCASTS=

# 每个播客采集的最新集数（默认 1）
#EPISODES_PER_PODCAST=1

# 阿里百炼 API — 统一回落 Key: 各模块未单独配置 API_KEY 时自动使用
# 注册地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# === LLM (OpenAI Compatible 协议) ===
# 换供应商示例: DeepSeek → LLM_BASE_URL=https://api.deepseek.com/v1
# 本地 Ollama → LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=EMPTY
#LLM_API_KEY=
#LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#LLM_MODEL=qwen3.7-plus

# === Embedding (OpenAI Compatible 协议) ===
#EMBEDDING_API_KEY=
#EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#EMBEDDING_MODEL=text-embedding-v4
#EMBEDDING_PROVIDER=api   # api | local (本地 BGE)

# === Rerank (HTTP API; OpenAI 协议无 rerank 标准, 走供应商 REST 端点) ===
#RERANK_API_KEY=
#RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
#RERANK_MODEL=qwen3-rerank

# === RAG 检索增强 ===
# 默认关闭（跳过 retriever 节点，节省 embedding/rerank 配额）。
# 未来需要长期运行、跨期积累语料做历史上下文增强时，设为 true 开启。
#ENABLE_RAG=false

# === ASR 语音转录 (HTTP filetrans 协议: 上传 + 提交 + 轮询) ===
#ASR_API_KEY=
#ASR_UPLOAD_URL=https://dashscope.aliyuncs.com/api/v1/uploads
#ASR_SUBMIT_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
#ASR_TASK_URL=https://dashscope.aliyuncs.com/api/v1/tasks/{task_id}
#ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans

# === 并发调优 ===
# 全局同时在途的 LLM 调用上限（分块并发与多集并发共享此额度，超出排队）
#LLM_CONCURRENCY=6
# 同时分析的播客集数（每集内部仍按块并发）
#EPISODE_CONCURRENCY=2
# 多文件 ASR 并发上传/提交数
#ASR_CONCURRENCY=3
